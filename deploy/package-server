#!/usr/bin/env bash
# Stage a server release from the committed deployment source.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
destination="${1:?usage: bash deploy/package-server NEW_DIRECTORY}"
mkdir "$destination"

git -C "$root" archive HEAD -- \
  .dockerignore .github/workflows/publish-server.yml CHANGELOG.md README.md pyproject.toml uv.lock \
  collector/sources.example.yaml collector/crawler collector/ui collector/serve.py collector/status.py \
  collector/web_jobs.py collector/web_preview.py collector/web_worker.py collector/verify_coverage.py \
  collector/collect.py collector/cdx_seed.py collector/mine_site.py collector/export_csv.py collector/health.py collector/supervisor.py collector/registration.py \
  collector/{README,ARCHITECTURE}.md \
  collector/tests/{conftest,test_acceptance_reverse,test_contract,test_endpoints,test_preview_robots,test_quality_exports,test_registration,test_settings,test_site_actions,test_web_service}.py deploy/verify-server \
  docs/images/crawler-workbench.png docs/images/crawler-task-queue.png \
  deploy/README.md deploy/Dockerfile deploy/compose.yaml deploy/start-web \
  deploy/install-camoufox.py deploy/server-release.md deploy/centos8 \
  | tar -xf - -C "$destination"

cp "$destination/collector/sources.example.yaml" "$destination/collector/sources.yaml"
# The standalone installer supports an operator editing the packaged catalog before building.
printf '\n!collector/sources.yaml\n' >> "$destination/.dockerignore"
