#!/usr/bin/env bash
# Stage a server release from the committed deployment source.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
destination="${1:?usage: bash deploy/package-server NEW_DIRECTORY}"
mkdir "$destination"

git -C "$root" archive HEAD -- \
  .dockerignore .github/workflows/publish-server.yml README.md pyproject.toml uv.lock \
  collector/crawler collector/ui collector/serve.py collector/status.py \
  collector/web_jobs.py collector/web_worker.py collector/web_preview.py collector/verify_coverage.py \
  collector/collect.py collector/export_csv.py collector/cli.py collector/cdx_seed.py collector/proxy_check.py \
  deploy/README.md deploy/Dockerfile deploy/compose.yaml deploy/start-web \
  deploy/install-camoufox.py deploy/server-release.md deploy/centos8 \
  | tar -xf - -C "$destination"

printf '[]\n' > "$destination/collector/sources.yaml"
