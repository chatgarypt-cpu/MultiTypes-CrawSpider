<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 采集守护进程：常驻 + KeepAlive。
       安装：参见 deploy/README.md。仓库/解释器路径若变动，改下面三处即可。 -->
  <key>Label</key>
  <string>com.reacrawl.supervisor</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/gary/项目开发/REA_CrawlSpider/演练场（ignore)/.venv/bin/python</string>
    <string>/Users/gary/项目开发/REA_CrawlSpider/collector/supervisor.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/gary/项目开发/REA_CrawlSpider</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>CRAWL_CONCURRENCY</key>
    <string>4</string>
    <key>SITE_WORKERS</key>
    <string>4</string>
    <key>CRAWL_RATE</key>
    <string>6</string>
    <key>CRAWL_MAX_RATE</key>
    <string>8</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- 崩溃重启节流，避免异常时 launchd 高频拉起 -->
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>/Users/gary/项目开发/REA_CrawlSpider/data/supervise.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/gary/项目开发/REA_CrawlSpider/data/supervise.err</string>
</dict>
</plist>
