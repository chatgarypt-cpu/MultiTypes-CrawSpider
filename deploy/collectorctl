#!/usr/bin/env bash
# collectorctl 包装脚本：用项目自带 venv 运行 collector/cli.py。
# 安装（可选）：
#   ln -sf "$(cd "$(dirname "$0")/.." && pwd)/deploy/collectorctl" /usr/local/bin/collectorctl
set -euo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="$REPO/演练场（ignore)/.venv/bin/python"
if [ ! -x "$PY" ]; then
  echo "✗ 找不到解释器：$PY（修改 deploy/collectorctl 里的 PY）" >&2
  exit 3
fi
exec "$PY" "$REPO/collector/cli.py" "$@"
