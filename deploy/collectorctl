#!/usr/bin/env bash
# collectorctl 包装脚本：用项目的 venv 运行 collector/cli.py。
# 解释器优先级：仓库根 .venv（uv sync 生成）→ 旧的 演练场（ignore)/.venv。
# 安装（可选）：
#   ln -sf "$(cd "$(dirname "$0")/.." && pwd)/deploy/collectorctl" /usr/local/bin/collectorctl
set -euo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="$REPO/.venv/bin/python"
if [ ! -x "$PY" ]; then
  PY="$REPO/演练场（ignore)/.venv/bin/python"
fi
if [ ! -x "$PY" ]; then
  echo "✗ 找不到解释器（先 cd \"$REPO\" && uv sync）：$REPO/.venv/bin/python" >&2
  exit 3
fi
exec "$PY" "$REPO/collector/cli.py" "$@"
